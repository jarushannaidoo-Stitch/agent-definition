{
  "version": 6,
  "description": "Engineering-team DAG: architect orchestrates, senior engineers build disjoint work packages in their own worktrees, git integrates, a spec-only gate judges, CSA reviews last, git publishes and cleans up.",
  "nodes": {
    "freeze_check": {"owner": "architect", "needs": []},
    "plan": {"owner": "architect", "needs": ["freeze_check"]},
    "setup": {"owner": "git", "needs": ["plan"]},
    "build": {"owner": "senior_engineer", "needs": ["setup"], "per_package": true, "parallel": true},
    "integrate": {"owner": "integrator", "needs": ["build"], "git": "git"},
    "lint": {"owner": "verifier", "needs": ["integrate"], "gate": true, "parallel": true},
    "tests": {"owner": "verifier", "needs": ["integrate"], "gate": true, "parallel": true},
    "verification": {"owner": "verifier", "needs": ["integrate"], "gate": true, "parallel": true},
    "spec_audit": {"owner": "slice_spec_audit", "needs": ["integrate"], "gate": true, "parallel": true},
    "styla": {"owner": "styla", "needs": ["integrate"], "gate": true, "parallel": true},
    "arc": {"owner": "arc", "needs": ["integrate"], "gate": true, "parallel": true},
    "csa_final": {"owner": "csa", "needs": ["lint", "tests", "verification", "spec_audit", "styla", "arc"], "gate": true},
    "publish": {"owner": "git", "needs": ["csa_final"], "local_signing": true, "description": "Local signing on Jarushan's machine (re-sign unsigned cloud commits), push with lease, open or update the stacked draft PR. Queued via runs/signing-queue.json while the machine is unavailable."},
    "ci": {"owner": "git", "needs": ["publish"]},
    "handoff": {"owner": "architect", "needs": ["ci"]},
    "cleanup": {"owner": "git", "needs": ["handoff"]},
    "closeout": {"owner": "architect", "needs": ["cleanup"]}
  },
  "loop_cap": 3
}
